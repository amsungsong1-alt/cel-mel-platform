# SAWA CEL MEL Platform -- credentials template
#
# SETUP: Copy to credentials.yaml and replace <BCRYPT_HASH> placeholders.
#   Generate a hash: python3 -c "import bcrypt; print(bcrypt.hashpw(b"Pass", bcrypt.gensalt(12)).decode())"
# credentials.yaml is in .gitignore -- it will NOT be committed.
#
# CLOUD: Paste credentials as TOML in Streamlit App Settings -> Secrets.
#   See utils/auth.py docstring for the exact TOML format.
#
# write_modules restricts Editors to specific modules only.
#
# k_role restricts Module K (Team Workspace) editing to only that account's
# own functional-role folder (GYSI, Biz Dev, Biz Coach, Comms, Admin,
# Finance, MEAL Admin, MEAL Asst, or Partner MEAL) -- the account also needs
# "K" in write_modules to write anything in Module K at all. "MEAL Admin"
# and "MEAL Asst" are the only k_roles that can see and edit every role's
# tasks/files (cross-role MEAL oversight). System Admin accounts always
# have full access regardless of k_role.

credentials:
  usernames:

    meal_officer:
      name: MEAL Officer
      email: meal@sawa-programme.org
      password: "<BCRYPT_HASH>"
      role: Admin
      k_role: MEAL Admin

    asst_meal:
      name: Assistant MEAL Officer
      email: asst.meal@sawa-programme.org
      password: "<BCRYPT_HASH>"
      role: Editor
      write_modules: [E, F, G, K]
      k_role: MEAL Asst

    gysi_officer:
      name: GYSI Officer
      email: gysi@sawa-programme.org
      password: "<BCRYPT_HASH>"
      role: Editor
      write_modules: [E, F, K]
      k_role: GYSI

    biz_dev:
      name: Business Development Officer
      email: bizdev@sawa-programme.org
      password: "<BCRYPT_HASH>"
      role: Editor
      write_modules: [A, K]
      k_role: Biz Dev

    comms_officer:
      name: Communications Officer
      email: comms@sawa-programme.org
      password: "<BCRYPT_HASH>"
      role: Editor
      write_modules: [K]
      k_role: Comms

    biz_coach:
      name: Business Coach
      email: bizcoach@sawa-programme.org
      password: "<BCRYPT_HASH>"
      role: Editor
      write_modules: [K]
      k_role: Biz Coach

    cel_admin:
      name: CEL Administrator
      email: cel.admin@sawa-programme.org
      password: "<BCRYPT_HASH>"
      role: Editor
      write_modules: [K]
      k_role: Admin

    finance_officer:
      name: Finance Officer
      email: finance@sawa-programme.org
      password: "<BCRYPT_HASH>"
      role: Editor
      write_modules: [K]
      k_role: Finance

    ceo:
      name: CEO
      email: ceo@sawa-programme.org
      password: "<BCRYPT_HASH>"
      role: Viewer
      view_modules: [I]

    exec_director:
      name: Executive Director
      email: ed@sawa-programme.org
      password: "<BCRYPT_HASH>"
      role: Viewer
      view_modules: [I]

    impl_partner:
      name: Implementing Partner
      email: partner@sawa-programme.org
      password: "<BCRYPT_HASH>"
      role: Editor
      write_modules: [K]
      k_role: Partner MEAL

cookie:
  name: cel_mel_auth
  key: "<random-secret-string-change-this>"
  expiry_days: 7
