# Copy to credentials.yaml (git-ignored) and replace passwords with bcrypt hashes.
# Generate a hash:  python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"

credentials:
  usernames:
    admin:
      name: Admin User
      email: admin@example.com
      password: $2b$12$REPLACE_WITH_BCRYPT_HASH
      role: Admin
    editor:
      name: Editor User
      email: editor@example.com
      password: $2b$12$REPLACE_WITH_BCRYPT_HASH
      role: Editor
    viewer:
      name: Viewer User
      email: viewer@example.com
      password: $2b$12$REPLACE_WITH_BCRYPT_HASH
      role: Viewer

cookie:
  name: cel_mel_auth
  key: CHANGE_THIS_TO_A_RANDOM_SECRET
  expiry_days: 30
